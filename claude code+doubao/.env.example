# ====================== LLM 配置 ======================
# 供应商选择: deepseek 或 doubao
LLM_PROVIDER=deepseek

# DeepSeek API 配置
DEEPSEEK_API_KEY=你的DeepSeek密钥
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-chat

# 豆包API配置（备用）
# DOUBAO_API_KEY=你的豆包密钥
# DOUBAO_ENDPOINT_ID=你的端点ID

# ====================== 数据库配置 ======================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME_AGRI=agri_db
DB_NAME_PESTICIDES=agri_pesticides_db

# ====================== 百度AI配置 ======================
BAIDU_API_KEY=你的百度AI密钥
BAIDU_SECRET_KEY=你的百度AI密钥

# ====================== 和风天气API ======================
QWEATHER_API_KEY=你的和风天气密钥

# ====================== 应用配置 ======================
API_SERVER_HOST=localhost
API_SERVER_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# ====================== 模型权重路径（可选，默认使用相对路径） ======================
# YOLO_MODEL_PATH=../yolo-weights/best.pt
# RESNET_MODEL_PATH=../resnet-weights/best.pt
# DEEPLABV3_MODEL_PATH=../deeplabv3_best.pth

# ====================== 农药Excel路径（可选，MySQL为主数据源） ======================
# PESTICIDE_EXCEL_PATH=E:/path/to/农药_农药产品库_世纪农药网.xlsx
